# CodeAlign — environment variables
# Copy this file to .env and fill in your values.

# Weights & Biases (required for all training phases)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=codealign
WANDB_ENTITY=your_wandb_username_or_team

# Hugging Face (required to download gated models/datasets)
HF_TOKEN=your_hf_token_here
