FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

ENV GOPATH=/usr/local/go_workspace
ENV CARGO_HOME=/usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup
ENV PATH="/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/go/bin:${GOPATH}/bin:${CARGO_HOME}/bin"

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    openjdk-17-jdk \
    golang-go \
    dotnet-sdk-8.0 \
    && python3 -m venv /opt/venv \
    && pip install --no-cache-dir ruff cpplint \
    && curl -fsSL https://nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g eslint typescript ts-node \
    && curl -sSL https://github.com/pmd/pmd/releases/download/pmd_releases%2F7.0.0/pmd-dist-7.0.0-bin.zip -o /tmp/pmd.zip \
    && apt-get install -y --no-install-recommends unzip \
    && unzip /tmp/pmd.zip -d /opt/ \
    && ln -s /opt/pmd-bin-7.0.0/bin/pmd /usr/local/bin/pmd \
    && curl --proto '=https' --tlsv1.2 -sSf https://rustup.rs | sh -s -- -y --default-toolchain stable \
    && chmod -R 755 ${CARGO_HOME} ${RUSTUP_HOME} \
    && rustup component add clippy \
    && curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/master/install.sh | sh -s -- -b /usr/local/bin \
    && apt-get purge -y unzip \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN useradd -m -s /bin/bash sandboxuser

WORKDIR /app
RUN chown -R sandboxuser:sandboxuser /app

USER sandboxuser

CMD ["/bin/bash"]