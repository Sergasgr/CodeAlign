# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Environment / secrets
.env

# Data & model artifacts (keep folder structure, not contents)
data/raw/*
data/curated/*
data/preferences/*
data/evaluation/*
!data/raw/.gitkeep
!data/curated/.gitkeep
!data/preferences/.gitkeep
!data/evaluation/.gitkeep

# Checkpoints — ignore everything, including final models (too large for git)
checkpoints/

# Intermediate training checkpoints (if checkpoints/ rule is ever relaxed)
checkpoint-*/

# Large model files (catch-all)
*.gguf
*.safetensors
*.bin
*.pt

# Experiment tracking
wandb/

# Notebooks
.ipynb_checkpoints/

# Rust build artifacts
rust-daemon/target/

# Preference generation checkpoints (resume files)
data/preferences/.checkpoint_*.json

# OS
.DS_Store

# Misc
/tmp*
*.rlib
/rust-daemon/src/code-executor-daemon.rs

# 3rd Party Tools (cloned via notebooks)
tools/

# IDEs and Editors
.vscode/
.idea/
*.swp